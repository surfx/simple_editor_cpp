[Desktop Entry]
Type=Application
Name=Simple Editor
GenericName=Text Editor
Comment=Leve editor de texto em C++ (Estilo Notepad++)
Exec=SimpleEditor %F
TryExec=SimpleEditor
Icon=text-x-generic
Terminal=false
Categories=Development;TextEditor;Utility;
MimeType=text/plain;text/x-c++src;text/x-c++hdr;text/x-csrc;text/x-chdr;text/x-python;text/x-shellscript;
Keywords=Text;Editor;C++;Qt;
StartupNotify=true
# Faz o gerenciador de janelas associar a janela (WM_CLASS / app_id) a esta
# entrada, mantendo o ícone correto mesmo com o editor fechado.
StartupWMClass=SimpleEditor
